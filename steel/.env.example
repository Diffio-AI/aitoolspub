# Copy to .env (git-ignored) and edit. docker compose reads it from this directory.

# Chrome's timezone. Keep it matching where this machine's IP is, e.g. America/New_York, Europe/Berlin.
TZ_NAME=UTC

# Captcha solving in the browser: nopecha-0.6.1 after running ./get-nopecha.sh, empty for none.
CAPTCHA_EXTENSION=

# Uncomment to give Chrome a real NVIDIA GPU (see gpu.yml).
# COMPOSE_FILE=docker-compose.yml:gpu.yml
# GPU_DEVICE=0
