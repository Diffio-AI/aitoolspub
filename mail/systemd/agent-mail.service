[Unit]
Description=agent-mail (Gmail mirror + MCP email tools for Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__AITOOLS_DIR__/mail
Environment=AGENT_MAIL_CONFIG=__AITOOLS_DIR__/mail/config.toml
Environment=PYTHONUNBUFFERED=1
ExecStart=__AITOOLS_DIR__/mail/.venv/bin/agent-mail serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
